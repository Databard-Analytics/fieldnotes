---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const briefs = (await getCollection('briefs', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 6);

const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => {
    const aTime = a.data.date ? a.data.date.getTime() : 0;
    const bTime = b.data.date ? b.data.date.getTime() : 0;
    return bTime - aTime;
  })
  .slice(0, 4);

const themes = await getCollection('themes');
---

<BaseLayout title="Fieldnotes" description="A public notebook of practical observations on AI, data, leadership, coaching, and strategic change.">
  <section class="card">
    <p>
      A public notebook of practical observations on AI, data, leadership, coaching, and strategic change.
      Built to surface signal, sharpen thinking, and make useful ideas easier to act on.
    </p>
  </section>

  <section>
    <h2>What you’ll find here</h2>
    <div class="card-grid">
      <article class="card">
        <h3><a href="/briefs">Daily Briefs</a></h3>
        <p>Short, timely observations on AI, data, coaching, and business change.</p>
      </article>
      <article class="card">
        <h3><a href="/notes">Notes</a></h3>
        <p>Concise reflections, frameworks, and practical takeaways.</p>
      </article>
      <article class="card">
        <h3><a href="/themes">Themes</a></h3>
        <p>Browse recurring ideas across AI strategy, data capability, coaching, leadership, and strategic change.</p>
      </article>
    </div>
  </section>

  <section>
    <h2>Latest briefs</h2>
    <div class="card-grid">
      {briefs.map((brief) => (
        <article class="card">
          <div class="meta">{brief.data.date.toISOString().slice(0, 10)}</div>
          <h3><a href={`/briefs/${brief.id}/`}>{brief.data.title}</a></h3>
          {brief.data.summary && <p>{brief.data.summary}</p>}
        </article>
      ))}
    </div>
  </section>

  <section>
    <h2>Notes</h2>
    <div class="card-grid">
      {notes.map((note) => (
        <article class="card">
          {note.data.date && <div class="meta">{note.data.date.toISOString().slice(0, 10)}</div>}
          <h3><a href={`/notes/${note.id}/`}>{note.data.title}</a></h3>
          {note.data.summary && <p>{note.data.summary}</p>}
        </article>
      ))}
    </div>
  </section>

  <section>
    <h2>Browse by theme</h2>
    <div class="card-grid">
      {themes.map((theme) => (
        <article class="card">
          <h3><a href={`/themes/${theme.id}/`}>{theme.data.name}</a></h3>
          <p>{theme.data.summary}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
